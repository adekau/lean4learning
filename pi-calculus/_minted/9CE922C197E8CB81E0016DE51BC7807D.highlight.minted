\PYG{c+c1}{\PYGZhy{}\PYGZhy{} The dispatcher process}
\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{dispatcher}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{tasks}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{List}\PYG{+w}{ }\PYG{n}{Name}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{pool}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Name}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{k}{Pi}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Listen for worker registrations on pool channel}
\PYG{+w}{  }\PYG{n+nb+bp}{.}\PYG{n}{recv}\PYG{+w}{ }\PYG{n}{pool}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}worker\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Send a task to the worker}
\PYG{+w}{  }\PYG{k}{match}\PYG{+w}{ }\PYG{n}{tasks}\PYG{+w}{ }\PYG{k}{with}
\PYG{+w}{  }\PYG{n+nb+bp}{|}\PYG{+w}{ }\PYG{o}{[]}\PYG{+w}{ }\PYG{n+nb+bp}{=\PYGZgt{}}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{nil}\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} no more tasks}
\PYG{+w}{  }\PYG{n+nb+bp}{|}\PYG{+w}{ }\PYG{n}{t}\PYG{+w}{ }\PYG{o}{::}\PYG{+w}{ }\PYG{n}{ts}\PYG{+w}{ }\PYG{n+nb+bp}{=\PYGZgt{}}
\PYG{+w}{    }\PYG{n+nb+bp}{.}\PYG{n}{send}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}worker\PYGZdq{}}\PYG{+w}{ }\PYG{n}{t}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{    }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Wait for result}
\PYG{+w}{    }\PYG{n+nb+bp}{.}\PYG{n}{recv}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}worker\PYGZdq{}}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}result\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{    }\PYG{n}{dispatcher}\PYG{+w}{ }\PYG{n}{ts}\PYG{+w}{ }\PYG{n}{pool}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} A worker process. It loops forever (`worker pool` recurses with the SAME}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} argument and no decreasing measure), so Lean cannot prove it terminates}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} and rejects a plain `def`. That is intentional: a server loop is *meant*}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} to run forever. We mark it `partial def` (which asks Lean to trust us}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} rather than check termination). A `partial def` returning `Pi` also needs}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} to know `Pi` is nonempty, so we register `Inhabited Pi` first.}
\PYG{k+kd}{instance}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Inhabited}\PYG{+w}{ }\PYG{k}{Pi}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{o}{⟨}\PYG{n+nb+bp}{.}\PYG{n}{nil}\PYG{o}{⟩}

\PYG{n}{partial}\PYG{+w}{ }\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{worker}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{pool}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Name}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{k}{Pi}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Register with dispatcher}
\PYG{+w}{  }\PYG{n+nb+bp}{.}\PYG{n}{send}\PYG{+w}{ }\PYG{n}{pool}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}self\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}\PYG{+w}{       }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} scope extrusion: pass our channel}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Receive task}
\PYG{+w}{  }\PYG{n+nb+bp}{.}\PYG{n}{recv}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}self\PYGZdq{}}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}task\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Process and return result (modeled as tau + send)}
\PYG{+w}{  }\PYG{k}{Pi}\PYG{n+nb+bp}{.}\PYG{n}{res}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}result\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{  }\PYG{n+nb+bp}{.}\PYG{n}{send}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}self\PYGZdq{}}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}result\PYGZdq{}}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{}|}
\PYG{+w}{  }\PYG{n}{worker}\PYG{+w}{ }\PYG{n}{pool}\PYG{+w}{                 }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} loop: re\PYGZhy{}register}
\end{MintedVerbatim}
