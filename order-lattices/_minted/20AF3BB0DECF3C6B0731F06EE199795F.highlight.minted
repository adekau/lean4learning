\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{namespace}\PYG{+w}{ }\PYG{n}{Propagators}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} A propagator step is an IO action that returns}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} true if it caused any cell to change.}
\PYG{k+kn}{abbrev}\PYG{+w}{ }\PYG{n}{PropStep}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{IO}\PYG{+w}{ }\PYG{n}{Bool}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Run a list of propagators to fixpoint.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Each pass re\PYGZhy{}runs all propagators; we stop when}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} a full pass causes no changes.}
\PYG{k+kn}{def}\PYG{+w}{ }\PYG{n}{runToFixpoint}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{steps}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Array}\PYG{+w}{ }\PYG{n}{PropStep}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{IO}\PYG{+w}{ }\PYG{n}{Unit}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k}{do}
\PYG{+w}{  }\PYG{k}{let}\PYG{+w}{ }\PYG{n}{mut}\PYG{+w}{ }\PYG{n}{changed}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{true}
\PYG{+w}{  }\PYG{n}{while}\PYG{+w}{ }\PYG{n}{changed}\PYG{+w}{ }\PYG{k}{do}
\PYG{+w}{    }\PYG{n}{changed}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{false}
\PYG{+w}{    }\PYG{n}{for}\PYG{+w}{ }\PYG{n}{step}\PYG{+w}{ }\PYG{k}{in}\PYG{+w}{ }\PYG{n}{steps}\PYG{+w}{ }\PYG{k}{do}
\PYG{+w}{      }\PYG{k}{let}\PYG{+w}{ }\PYG{n}{c}\PYG{+w}{ }\PYG{n+nb+bp}{←}\PYG{+w}{ }\PYG{n}{step}
\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{n}{c}\PYG{+w}{ }\PYG{k}{then}\PYG{+w}{ }\PYG{n}{changed}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{true}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} A smarter scheduler that only re\PYGZhy{}runs propagators}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} whose inputs changed (using a dependency queue).}
\PYG{k+kn}{structure}\PYG{+w}{ }\PYG{n}{Network}\PYG{+w}{ }\PYG{k+kn}{where}
\PYG{+w}{  }\PYG{n}{steps}\PYG{+w}{    }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Array}\PYG{+w}{ }\PYG{n}{PropStep}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} In a production implementation, steps would be indexed}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} and cells would hold lists of dependent propagator IDs.}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} For clarity we use the simple \PYGZdq{}run all\PYGZdq{} scheduler here.}

\PYG{k+kn}{def}\PYG{+w}{ }\PYG{n}{Network}\PYG{n+nb+bp}{.}\PYG{n}{run}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{n}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Network}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{IO}\PYG{+w}{ }\PYG{n}{Unit}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{n}{runToFixpoint}\PYG{+w}{ }\PYG{n}{n}\PYG{n+nb+bp}{.}\PYG{n}{steps}

\PYG{k+kn}{end}\PYG{+w}{ }\PYG{n}{Propagators}
\end{MintedVerbatim}
