\PYG{c+c1}{\PYGZhy{}\PYGZhy{} The tighter of two lower bounds (their max, with none = \PYGZhy{}∞) …}
\PYG{k+kn}{def}\PYG{+w}{ }\PYG{n}{loMax}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Bound}\PYG{+w}{ }\PYG{n+nb+bp}{→}\PYG{+w}{ }\PYG{n}{Bound}\PYG{+w}{ }\PYG{n+nb+bp}{→}\PYG{+w}{ }\PYG{n}{Bound}
