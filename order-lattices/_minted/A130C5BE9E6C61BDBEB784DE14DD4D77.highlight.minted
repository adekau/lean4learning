\PYG{+w}{    }\PYG{n}{cases}\PYG{+w}{ }\PYG{n}{a1}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{};\PYGZgt{}}\PYG{+w}{ }\PYG{n}{cases}\PYG{+w}{ }\PYG{n}{a2}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{};\PYGZgt{}}\PYG{+w}{ }\PYG{n}{cases}\PYG{+w}{ }\PYG{n}{b1}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZlt{};\PYGZgt{}}\PYG{+w}{ }\PYG{n}{cases}\PYG{+w}{ }\PYG{n}{b2}
\PYG{+w}{      }\PYG{n+nb+bp}{\PYGZlt{};\PYGZgt{}}\PYG{+w}{ }\PYG{n}{simp\PYGZus{}all}\PYG{+w}{ }\PYG{o}{[}\PYG{n}{FlatNat}\PYG{n+nb+bp}{.}\PYG{n}{addFn}\PYG{o}{,}\PYG{+w}{ }\PYG{n}{FlatNat}\PYG{n+nb+bp}{.}\PYG{n}{le\PYGZus{}def}\PYG{o}{,}\PYG{+w}{ }\PYG{n}{FlatNat}\PYG{n+nb+bp}{.}\PYG{n}{le}\PYG{o}{]}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Proof: subFn is monotone.}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Same strategy. After the case split, the remaining goals are stuck}
