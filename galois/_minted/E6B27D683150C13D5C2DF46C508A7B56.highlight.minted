\PYG{c+c1}{\PYGZhy{}\PYGZhy{} We represent ℤ/nℤ as Fin n (for n ≥ 1)}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Fin n = \PYGZob{} val : Nat // val \PYGZlt{} n \PYGZcb{}}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Addition is modular: (a + b) mod n}

\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{Fin.addMod}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{a}\PYG{+w}{ }\PYG{n}{b}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Fin}\PYG{+w}{ }\PYG{n}{n}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Fin}\PYG{+w}{ }\PYG{n}{n}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} `Nat.mod\PYGZus{}lt` needs 0 \PYGZlt{} n; we recover it from `a : Fin n`, whose}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} proof `a.isLt : a.val \PYGZlt{} n` forces n to be positive.}
\PYG{+w}{  }\PYG{o}{⟨(}\PYG{n}{a.val}\PYG{+w}{ }\PYG{n+nb+bp}{+}\PYG{+w}{ }\PYG{n}{b.val}\PYG{o}{)}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZpc{}}\PYG{+w}{ }\PYG{n}{n}\PYG{o}{,}
\PYG{+w}{    }\PYG{n}{Nat.mod\PYGZus{}lt}\PYG{+w}{ }\PYG{n}{\PYGZus{}}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{Nat.lt\PYGZus{}of\PYGZus{}le\PYGZus{}of\PYGZus{}lt}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{Nat.zero\PYGZus{}le}\PYG{+w}{ }\PYG{n}{a.val}\PYG{o}{)}\PYG{+w}{ }\PYG{n}{a.isLt}\PYG{o}{)⟩}

\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{Fin.negMod}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{a}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Fin}\PYG{+w}{ }\PYG{n}{n}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{h}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{n}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZgt{}}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Fin}\PYG{+w}{ }\PYG{n}{n}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{o}{⟨(}\PYG{n}{n}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZhy{}}\PYG{+w}{ }\PYG{n}{a.val}\PYG{o}{)}\PYG{+w}{ }\PYG{n+nb+bp}{\PYGZpc{}}\PYG{+w}{ }\PYG{n}{n}\PYG{o}{,}\PYG{+w}{ }\PYG{n}{Nat.mod\PYGZus{}lt}\PYG{+w}{ }\PYG{n}{\PYGZus{}}\PYG{+w}{ }\PYG{n}{h}\PYG{o}{⟩}
\end{MintedVerbatim}
