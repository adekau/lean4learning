\PYG{c+c1}{\PYGZhy{}\PYGZhy{} A homomorphism preserves the identity}
\PYG{k+kd}{theorem}\PYG{+w}{ }\PYG{n}{GroupHom.map\PYGZus{}one}\PYG{+w}{ }\PYG{o}{[}\PYG{n}{Group}\PYG{+w}{ }\PYG{n}{G}\PYG{o}{]}\PYG{+w}{ }\PYG{o}{[}\PYG{n}{Group}\PYG{+w}{ }\PYG{n}{H}\PYG{o}{]}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{φ}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{GroupHom}\PYG{+w}{ }\PYG{n}{G}\PYG{+w}{ }\PYG{n}{H}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}
\PYG{+w}{    }\PYG{n}{φ.toFun}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{+w}{ }\PYG{n+nb+bp}{=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k+kd}{by}
\PYG{+w}{  }\PYG{k}{have}\PYG{+w}{ }\PYG{n}{h}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{φ.map\PYGZus{}mul}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{+w}{ }\PYG{l+m+mi}{1}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} h : φ.toFun (1 * 1) = φ.toFun 1 * φ.toFun 1.}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Since 1 * 1 = 1 (Group.mul\PYGZus{}one), this says}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{}   φ.toFun 1 = φ.toFun 1 * φ.toFun 1;}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} multiplying both sides on the right by (φ.toFun 1)⁻¹ finishes.}
\PYG{+w}{  }\PYG{g+gr}{sorry}\PYG{+w}{ }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Exercise for the reader}

