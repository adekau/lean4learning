\contentsline {subsubsection}{\numberline {7.4.2}The Complete Rules}{23}{subsubsection.7.4.2}%
\contentsline {subsubsection}{\numberline {7.4.3}Rule by Rule, in Depth}{23}{subsubsection.7.4.3}%
\contentsline {paragraph}{Rule 1: $x[x := a] = a$.}{23}{section*.12}%
\contentsline {paragraph}{Rule 2: $y[x := a] = y$ when $y \neq x$.}{23}{section*.13}%
\contentsline {paragraph}{Rule 3: $(\lambda x.\, e)[x := a] = \lambda x.\, e$ (shadowing).}{23}{section*.14}%
\contentsline {paragraph}{Rule 4: $(\lambda y.\, e)[x := a] = \lambda y.\, (e[x := a])$ (safe descent).}{23}{section*.15}%
\contentsline {paragraph}{Rule 5: $(\lambda y.\, e)[x := a] = \lambda z.\, (e[y := z][x := a])$ (capture avoidance).}{23}{section*.16}%
\contentsline {paragraph}{Rule 6: $(e_1\tmspace +\thickmuskip {.2777em}e_2)[x := a] = (e_1[x := a])\tmspace +\thickmuskip {.2777em}(e_2[x := a])$ (application).}{24}{section*.17}%
