\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Parse an identifier: one or more alphanumeric/underscore characters}
\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{ident}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Parser}\PYG{+w}{ }\PYG{n}{String}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{token}\PYG{+w}{ }\PYG{k}{do}
