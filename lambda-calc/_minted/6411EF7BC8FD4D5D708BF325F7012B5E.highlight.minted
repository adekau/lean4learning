\PYG{+w}{  }\PYG{n}{pure}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{atoms.tail.foldl}\PYG{+w}{ }\PYG{n}{Term.app}\PYG{+w}{ }\PYG{n}{atoms.head}\PYG{n+nb+bp}{!}\PYG{o}{)}

