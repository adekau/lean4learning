\PYG{c+c1}{\PYGZhy{}\PYGZhy{} These four parsers are MUTUALLY recursive (lamP calls exprP, exprP calls}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} appP, appP calls atomP, atomP calls exprP), so they must be wrapped in a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} `mutual ... end` block; otherwise Lean reports \PYGZdq{}unknown identifier exprP\PYGZdq{}.}
\PYG{k+kd}{mutual}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Parse a lambda: \PYGZsq{}\PYGZbs{}\PYGZsq{} ident+ \PYGZsq{}.\PYGZsq{} expr}
\PYG{n}{partial}\PYG{+w}{ }\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{lamP}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Parser}\PYG{+w}{ }\PYG{n}{Term}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k}{do}
