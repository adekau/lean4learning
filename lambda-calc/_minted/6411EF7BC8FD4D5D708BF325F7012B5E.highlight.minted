\PYG{+w}{  }\PYG{k}{let}\PYG{+w}{ }\PYG{n}{params}\PYG{+w}{ }\PYG{n+nb+bp}{←}\PYG{+w}{ }\PYG{n}{many1}\PYG{+w}{ }\PYG{n}{ident}\PYG{+w}{       }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} collect parameter names}
\PYG{+w}{  }\PYG{k}{let}\PYG{+w}{ }\PYG{n}{\PYGZus{}}\PYG{+w}{ }\PYG{n+nb+bp}{←}\PYG{+w}{ }\PYG{n}{symbol}\PYG{+w}{ }\PYG{l+s+sc}{\PYGZsq{}.\PYGZsq{}}
\PYG{+w}{  }\PYG{k}{let}\PYG{+w}{ }\PYG{n}{body}\PYG{+w}{ }\PYG{n+nb+bp}{←}\PYG{+w}{ }\PYG{n}{exprP}\PYG{+w}{               }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} parse the body}
\PYG{+w}{  }\PYG{n}{pure}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{params.foldr}\PYG{+w}{ }\PYG{n}{Term.lam}\PYG{+w}{ }\PYG{n}{body}\PYG{o}{)}\PYG{+w}{ }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} desugar: [x,y] → lam x (lam y body)}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Parse an application: atom+, left\PYGZhy{}associative}
\PYG{n}{partial}\PYG{+w}{ }\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{appP}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Parser}\PYG{+w}{ }\PYG{n}{Term}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k}{do}
