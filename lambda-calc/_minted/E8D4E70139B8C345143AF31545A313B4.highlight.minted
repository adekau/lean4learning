\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{kProof}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{DTerm}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{n+nb+bp}{.}\PYG{n}{lam}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{univ}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{lam}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{univ}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{lam}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{bvar}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{lam}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{bvar}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{(}\PYG{n+nb+bp}{.}\PYG{n}{bvar}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{o}{))))}

