\PYG{l+s+sd}{/\PYGZhy{}\PYGZhy{} Precompute contribution of each combo to each stat on each slot.}
\PYG{l+s+sd}{    Access: contribTable[slot][combo][stat] \PYGZhy{}/}
\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{buildContribTable}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Array}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{Array}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{Array}\PYG{+w}{ }\PYG{n}{Nat}\PYG{o}{))}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{n}{GearSlot.all.toArray.map}\PYG{+w}{ }\PYG{k}{fun}\PYG{+w}{ }\PYG{n}{slot}\PYG{+w}{ }\PYG{n+nb+bp}{=\PYGZgt{}}
\PYG{+w}{    }\PYG{n}{allCombos.toArray.map}\PYG{+w}{ }\PYG{k}{fun}\PYG{+w}{ }\PYG{n}{combo}\PYG{+w}{ }\PYG{n+nb+bp}{=\PYGZgt{}}
\PYG{+w}{      }\PYG{n}{StatType.all.toArray.map}\PYG{+w}{ }\PYG{k}{fun}\PYG{+w}{ }\PYG{n}{stat}\PYG{+w}{ }\PYG{n+nb+bp}{=\PYGZgt{}}
\PYG{+w}{        }\PYG{n}{contribution}\PYG{+w}{ }\PYG{n}{slot}\PYG{+w}{ }\PYG{n}{combo}\PYG{+w}{ }\PYG{n}{stat}

\PYG{l+s+sd}{/\PYGZhy{}\PYGZhy{} Precompute max contribution per stat per domain.}
\PYG{l+s+sd}{    Avoids recomputing during propagation. \PYGZhy{}/}
\PYG{k+kd}{structure}\PYG{+w}{ }\PYG{n}{DomainStats}\PYG{+w}{ }\PYG{n}{where}
\PYG{+w}{  }\PYG{n}{maxPerStat}\PYG{+w}{  }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Array}\PYG{+w}{ }\PYG{n}{Nat}\PYG{+w}{   }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} maxPerStat[stat] = max contribution in domain}
\PYG{+w}{  }\PYG{n}{minPerStat}\PYG{+w}{  }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Array}\PYG{+w}{ }\PYG{n}{Nat}\PYG{+w}{   }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} minPerStat[stat] = min contribution in domain}
\PYG{+w}{  }\PYG{n}{sumMaxPower}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Nat}\PYG{+w}{         }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} cached sum for quick feasibility check}
