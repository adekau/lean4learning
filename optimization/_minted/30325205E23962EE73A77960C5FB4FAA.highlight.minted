\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{l+s+sd}{/\PYGZhy{}\PYGZhy{} Any total order on combos will do; here, by name length then name. \PYGZhy{}/}
\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{comboOrd}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{c}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{StatCombo}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Nat}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{n}{c.name.length}

\PYG{l+s+sd}{/\PYGZhy{}\PYGZhy{} A build is canonical if symmetric slot pairs are ordered. \PYGZhy{}/}
\PYG{k+kd}{def}\PYG{+w}{ }\PYG{n}{Build.isCanonical}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Build}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{k+kt}{Prop}\PYG{+w}{ }\PYG{o}{:=}
\PYG{+w}{  }\PYG{n}{comboOrd}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b.gear}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{ring1}\PYG{o}{)}\PYG{+w}{ }\PYG{n+nb+bp}{≤}\PYG{+w}{ }\PYG{n}{comboOrd}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b.gear}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{ring2}\PYG{o}{)}\PYG{+w}{ }\PYG{n+nb+bp}{∧}
\PYG{+w}{  }\PYG{n}{comboOrd}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b.gear}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{accessory1}\PYG{o}{)}\PYG{+w}{ }\PYG{n+nb+bp}{≤}\PYG{+w}{ }\PYG{n}{comboOrd}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b.gear}\PYG{+w}{ }\PYG{n+nb+bp}{.}\PYG{n}{accessory2}\PYG{o}{)}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} SPECIFICATION (proof left as an extended exercise): every build has a}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} canonical equivalent with the same penalty. `sorry` marks it UNPROVEN.}
\PYG{k+kd}{theorem}\PYG{+w}{ }\PYG{n}{canonical\PYGZus{}exists}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{b}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Build}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}
\PYG{+w}{    }\PYG{n+nb+bp}{∃}\PYG{+w}{ }\PYG{n}{b\PYGZsq{}}\PYG{o}{,}\PYG{+w}{ }\PYG{n}{b\PYGZsq{}.isCanonical}\PYG{+w}{ }\PYG{n+nb+bp}{∧}\PYG{+w}{ }\PYG{n}{totalPenalty}\PYG{+w}{ }\PYG{n}{b\PYGZsq{}}\PYG{+w}{ }\PYG{n+nb+bp}{=}\PYG{+w}{ }\PYG{n}{totalPenalty}\PYG{+w}{ }\PYG{n}{b}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k+kd}{by}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Swap rings/accessories if needed; stat totals are unchanged because}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} contribution depends only on the slot type, not the index}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} (coefficients .ring1 = coefficients .ring2).}
\PYG{+w}{  }\PYG{g+gr}{sorry}
