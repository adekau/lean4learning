\PYG{+w}{    }\PYG{n+nb+bp}{∀}\PYG{+w}{ }\PYG{n}{alloc}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{StatType}\PYG{+w}{ }\PYG{n+nb+bp}{→}\PYG{+w}{ }\PYG{n}{Nat}\PYG{o}{,}
\PYG{+w}{      }\PYG{o}{(}\PYG{n}{StatType.all.map}\PYG{+w}{ }\PYG{n}{alloc}\PYG{o}{)}\PYG{n+nb+bp}{.}\PYG{n}{sum}\PYG{+w}{ }\PYG{n+nb+bp}{=}\PYG{+w}{ }\PYG{n}{budget}\PYG{+w}{ }\PYG{n+nb+bp}{→}
\PYG{+w}{      }\PYG{n}{totalInfusionPenalty}\PYG{+w}{ }\PYG{n}{gearStats}\PYG{+w}{ }\PYG{n}{targets}\PYG{+w}{ }\PYG{n}{dpAlloc}\PYG{+w}{ }\PYG{n+nb+bp}{≤}
