\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} Two LP interfaces coexist: `solveLPRelaxation` (returns a bare Nat bound,}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} used by branchAndBound\PYGZsq{}s prune test) and `solveLPRelaxationF` (returns an}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} LPResult record with `.objectiveValue : Float` and reduced costs, used}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} for reduced\PYGZhy{}cost fixing and dual certificates). This lemma uses the}
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} record variant.}
\PYG{l+s+sd}{/\PYGZhy{}\PYGZhy{} The LP relaxation value is a lower bound on any integer solution. \PYGZhy{}/}
\PYG{k+kd}{theorem}\PYG{+w}{ }\PYG{n}{lp\PYGZus{}bound\PYGZus{}valid}
\PYG{+w}{    }\PYG{o}{(}\PYG{n}{node}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{BBNode}\PYG{o}{)}
\PYG{+w}{    }\PYG{o}{(}\PYG{n}{lpResult}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{LPResult}\PYG{o}{)}
\PYG{+w}{    }\PYG{o}{(}\PYG{n}{h\PYGZus{}lp}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{lpResult}\PYG{+w}{ }\PYG{n+nb+bp}{=}\PYG{+w}{ }\PYG{n}{solveLPRelaxationF}\PYG{+w}{ }\PYG{n}{node.domains}\PYG{+w}{ }\PYG{n}{node.targets}\PYG{o}{)}
\PYG{+w}{    }\PYG{o}{(}\PYG{n}{b}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n}{Build}\PYG{o}{)}
\PYG{+w}{    }\PYG{o}{(}\PYG{n}{h\PYGZus{}feasible}\PYG{+w}{ }\PYG{o}{:}\PYG{+w}{ }\PYG{n+nb+bp}{∀}\PYG{+w}{ }\PYG{n}{s}\PYG{o}{,}\PYG{+w}{ }\PYG{n}{b.gear}\PYG{+w}{ }\PYG{n}{s}\PYG{+w}{ }\PYG{n+nb+bp}{∈}\PYG{+w}{ }\PYG{n}{node.domains}\PYG{+w}{ }\PYG{n}{s}\PYG{o}{)}\PYG{+w}{ }\PYG{o}{:}
\PYG{+w}{    }\PYG{n}{lpResult.objectiveValue}\PYG{+w}{ }\PYG{n+nb+bp}{≤}\PYG{+w}{ }\PYG{o}{(}\PYG{n}{totalPenalty}\PYG{+w}{ }\PYG{n}{b}\PYG{+w}{ }\PYG{n}{node.targets}\PYG{+w}{ }\PYG{n}{wMiss}\PYG{+w}{ }\PYG{n}{wOver}\PYG{o}{)}\PYG{n+nb+bp}{.}\PYG{n}{toFloat}\PYG{+w}{ }\PYG{o}{:=}\PYG{+w}{ }\PYG{k+kd}{by}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} b is a 0\PYGZhy{}1 point feasible for the LP, and the LP optimum ≤ any feasible}
\PYG{+w}{  }\PYG{c+c1}{\PYGZhy{}\PYGZhy{} LP value; the relaxation only enlarges the feasible set.}
\PYG{+w}{  }\PYG{g+gr}{sorry}
